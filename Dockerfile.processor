ARG BASE_IMAGE=pytorch/pytorch:2.1.0-cuda12.1-cudnn8-devel
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    libespeak-ng1 \
    ffmpeg \
    mecab \
    libmecab-dev \
    mecab-ipadic-utf8 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install epub2tts and all dependencies
RUN pip install --no-cache-dir epub2tts

# Pre-install spacy English model to avoid runtime uv errors
RUN pip install --no-cache-dir \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl

# Pre-download kokoro model weights into the image
RUN python -c "from kokoro import KPipeline; KPipeline(lang_code='a', repo_id='hexgrad/Kokoro-82M')"

WORKDIR /app
COPY process_epubs.py .

# epub and audiobooks dirs are mounted at runtime
ENV EPUB_DIR=/data/epub
ENV AUDIOBOOKS_DIR=/data/audiobooks
ENV TTS_ENGINE=kokoro

ENTRYPOINT ["python", "process_epubs.py"]
